{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.d.ts",
      "default": [
        "./src/*",
        "./src/*.ts"
      ]
    }
  },
  "scripts": {
    "build": "marko-run build && node scripts/rebase-html.mjs",
    "deploy": "pnpm run build && gh-pages --nojekyll -d dist/public -u \"marko-js <noreply@markojs.com>\"",
    "dev": "marko-run",
    "format": "prettier . -w",
    "lint": "markdownlint \"docs/**/*.md\"",
    "prepare": "husky",
    "preview": "marko-run preview",
    "test": "vitest run",
    "type-check": "marko-type-check"
  },
  "dependencies": {
    "@ebay/browserslist-config": "^2.16.0",
    "flexsearch": "^0.8.212"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@jridgewell/source-map": "^0.3.11",
    "@marko/compiler": "^5.42.5",
    "@marko/language-server": "^3.4.0",
    "@marko/language-tools": "^2.7.0",
    "@marko/run": "^0.11.12",
    "@marko/run-adapter-static": "^2.0.10",
    "@marko/type-check": "^3.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/browser": "^4.63.4",
    "@shikijs/langs": "^4.4.3",
    "@types/flexsearch": "^0.7.42",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.2",
    "@types/semver": "^7.8.0",
    "assert": "link:shim/assert",
    "autoprefixer": "^10.6.1",
    "codemirror": "^6.0.2",
    "gh-pages": "^6.3.0",
    "github-slugger": "^2.0.0",
    "glob": "^13.0.6",
    "hastscript": "^9.0.1",
    "husky": "^9.1.7",
    "lasso-package-root": "^1.0.1",
    "lightningcss-wasm": "^1.33.0",
    "lz-string": "^1.5.0",
    "markdownlint-cli": "^0.49.1",
    "marked": "^18.0.14",
    "marko": "^6.3.52",
    "path": "link:shim/path",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.28",
    "postcss-import": "^17.0.0",
    "postcss-preset-env": "^11.5.3",
    "prettier": "^3.9.8",
    "prettier-plugin-marko": "^4.1.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "pretty-format": "^30.5.1",
    "resolve-sync": "^1.2.2",
    "sass-embedded": "^1.105.0",
    "satori": "^0.33.5",
    "semver": "^7.8.5",
    "shiki": "^4.4.3",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "util": "link:shim/util",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-languageserver-types": "^3.17.6",
    "vscode-uri": "^3.2.0",
    "writable-dom": "^1.0.6"
  },
  "packageManager": "pnpm@11.15.1"
}
