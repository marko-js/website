import type { File, Variants } from "./core/build.ts";

export interface Precompiled {
  files: File[];
  html: string;
  css: string;
  js: string;
  sources: { path: string; html: string }[];
  /** Per file, the html/concise and TS/JS forms of its source, if it has them. */
  variants?: (Variants | null)[];
  variantSources?: (Record<string, string> | null)[];
  sourceCSS: string;
}

export interface Input {
  /** A directory of example files, relative to the template using this tag. Read at build time. */
  dir?: string;
  /** Per file, the html/concise and TS/JS forms of a Marko file, for hosts that toggle them. */
  variants?: (Variants | null)[];
  /** Example files, as in the playground. Static values are pre-compiled at build time. */
  files?: File[];
  /** Allow editing, which loads the editor and compiler on demand. Defaults to true. */
  editable?: boolean;
  /** Mount the example on the client instead of rendering it on the server. */
  csr?: boolean;
  /** Height of the preview, as any CSS length. */
  height?: string;
  /** Set by the compile-time transformer from `dir` or `files`. */
  precompiled?: Precompiled;
}

// The frame is a document of its own, so the example's styles can neither leak
// out nor be affected by the page. `</script` would end the inline module early.
static function toSrcdoc({ html, css, js }: Precompiled) {
  return (
    (css ? `<style>${css}</style>` : "") +
    html +
    (js
      ? `<script type="module">${js.replace(/<\/(script)/gi, "<\\/$1")}</scr` +
        `ipt>`
      : "")
  );
}

static function escapeHTML(text: string) {
  return text.replace(/[&<>]/g, (c) => `&#${c.charCodeAt(0)};`);
}

// Examples whose input is not known at build time have nothing to render
// until the editor loads and compiles them, so they start as plain text.
static function fromFiles(files: File[]): Precompiled {
  return {
    files,
    html: "",
    css: "",
    js: "",
    sourceCSS: "",
    sources: files.map(({ path, content }) => ({
      path,
      html: `<pre><code>${escapeHTML(content)}</code></pre>`,
    })),
  };
}

static function digits(text: string) {
  return Math.max(2, String(text.split("\n").length).length);
}

// The forms a Marko file can be shown in, in the order a host without its own
// styles falls back to. Other files have the one form.
static const formNames = [
  ["htmlTS", "html-ts"],
  ["html", "html"],
  ["conciseTS", "concise-ts"],
  ["concise", "concise"],
] as const;
static function panes(
  forms: Record<string, string> | null | undefined,
  texts: Variants | null | undefined,
  html: string,
  content: string,
) {
  return forms && texts
    ? formNames.map(([key, name]) => ({
        name,
        html: forms[key],
        text: texts[key],
      }))
    : [{ name: "", html, text: content }];
}

<id/id>
<const/pre=input.precompiled || (input.files && fromFiles(input.files))>
<const/editable=input.editable !== false>
<if=pre>
  <const/srcdoc=toSrcdoc(pre)>
  <div.live-preview/root style=input.height && `--lp-height:${input.height}`>
    <if=(pre.files.length > 1)>
      <for|file, i| of=pre.files>
        <input.tab-input
          type="radio"
          name=`${id}-tab`
          id=`${id}-${i}`
          checked=i === 0
          aria-label=file.path
        >
      </for>
      <div.tabs>
        <for|file, i| of=pre.files>
          <label.tab for=`${id}-${i}`>${file.path}</label>
        </for>
      </div>
    </if>
    <div.sources>
      <for|source, i| of=pre.sources>
        <const/forms=pre.variantSources?.[i]>
        <div.source data-path=source.path class=forms && "has-variants">
          <for|pane|
            of=panes(
              forms,
              pre.variants?.[i],
              source.html,
              pre.files[i].content,
            )
          >
            <div.variant
              class=pane.name
              style=`--lp-digits:${digits(pane.text)}`
              contenteditable=editable && "plaintext-only"
              role=editable && "textbox"
              aria-multiline=editable && "true"
              aria-label=editable && source.path
              spellcheck=editable && "false"
            >
              $!{pane.html}
            </div>
          </for>
        </div>
      </for>
    </div>
    <div.output>
      <iframe.preview title="Preview" srcdoc=srcdoc loading="lazy"/>
      <div.errors role="alert" hidden/>
    </div>
    <if=editable>
      <const/files=pre.files>
      <const/variants=pre.variants>
      <const/needsBuild=!input.precompiled>
      <const/csr=input.csr>
      <script>
        // The editor and its highlighter load when an editor is first focused
        // (or at once when there is nothing pre-compiled to show).
        const el = root();
        const load = () =>
          import("./core/attach.ts").then(({ attach }) =>
            attach(el, files, {
              variants,
              build: needsBuild,
              csr,
              signal: $signal,
            }),
          );
        if (needsBuild) {
          load();
        } else {
          el.addEventListener("focusin", load, { once: true, signal: $signal });
        }
      </script>
    </if>
  </div>
  <html-style>${pre.sourceCSS}</html-style>
</if>
